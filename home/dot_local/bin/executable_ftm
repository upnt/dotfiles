#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

DEFAULT_SESSION_NAME=workspace

tmux start-server

sessions=("alpha" "beta" "gamma")
candidates=("${sessions[@]}")

set +e
selection=$(printf "%s\n" "${candidates[@]}" | \
  fzf --tmux 90% --style full --prompt='tmux session> ' --header=$'Enterで選択\n')
fzf_status=$?
set -e

if (( fzf_status != 0 )) || [[ -z "${selection:-}" ]]; then
  if [[ ! -o interactive ]]; then
    exec "${SHELL:-/bin/zsh}" -l
  fi
  return 0 2>/dev/null
fi

in_tmux=${+TMUX}

if ! tmux has-session -t "$selection" 2>/dev/null; then
  tmux-new-window "$selection"
else
  if (( in_tmux )); then
    tmux switch-client -t "$selection"
  else
    tmux attach -t "$selection"
  fi
fi
