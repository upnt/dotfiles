#!/bin/sh

dir="${1:-.}"

if ! git -C "$dir" rev-parse --is-inside-work-tree 1>/dev/null 2>&1; then
    exit 1
fi

if [ -n "$(git -C "$dir" status -s)" ]; then
    echo "There are uncommited files"
fi

if git -C "$dir" status | grep -q 'ahead of'; then
    echo "There are unpushed files"
fi

exit 0
